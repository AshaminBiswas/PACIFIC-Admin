# ==============================================================================
# PACIFIC RESTROOM CUBICLE — ADMIN PANEL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure with Pacific credentials
# ==============================================================================

# ─── Backend API Connection ───────────────────────────────────────────────────
# URL of PACIFIC-Backend (Express API)
VITE_API_URL=http://localhost:5001/api/v1

# ─── Pacific Supabase Cloud Infrastructure ────────────────────────────────────
# Supabase project URL and anon public key
VITE_SUPABASE_URL=https://[YOUR_PACIFIC_PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ─── App URLs & Defaults ──────────────────────────────────────────────────────
VITE_STOREFRONT_URL=
