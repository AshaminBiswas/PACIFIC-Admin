# ==============================================================================
# PACIFIC RESTROOM CUBICLE — ADMIN PANEL & CRM ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure with your environment credentials:
#   cp .env.example .env
# ==============================================================================

# ─── 1. Backend API Connection (Required for CRM) ─────────────────────────────
# Base URL of PACIFIC-Backend (Express API hosting /api/v1/wacrm routes)
# Local Development: http://localhost:5001/api/v1
# Production:        https://pacific-backend-psuw.onrender.com/api/v1
VITE_API_URL="http://localhost:5001/api/v1"

# ─── 2. Pacific Supabase Cloud Infrastructure (Required for Auth & CRM) ────────
# Supabase project URL and keys for authentication and real-time data
VITE_SUPABASE_URL="https://[YOUR_PACIFIC_PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ─── 3. CRM Operator & Storefront Defaults ─────────────────────────────────────
# Default operator email shown in Pacific Admin CRM when name is not set
VITE_ADMIN_DEFAULT_EMAIL="sales@pacificrestroomcubicle.com"

# Public storefront URL for customer redirection and catalog links
VITE_STOREFRONT_URL="http://localhost:5173"

# ─── 4. Client-side AI Assistance (Optional) ──────────────────────────────────
# NVIDIA NIM or OpenAI key for optional direct client-side catalog intelligence
VITE_NVIDIA_API_KEY=""
